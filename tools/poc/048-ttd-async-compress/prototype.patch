+void TTDPieceStore::Settle(TTDPieceId id)
+{
+    auto it = _async->byId.find(id);
+    if (it == _async->byId.end())
+        return;
+    Job& job = *it->second;
+    WaitFor(job);
+    Apply(job);
+    Harvest();
+}
