+
+// POC 048: the worker stores what the calling thread would have stored, byte for byte
+#include <cstdlib>
+namespace
+{
+TEST(TTDPieceStorePoc048_Test, WorkerStoresTheSameVersions)
+{
+    for (const char* mode : {"1", "2"})
+    {
+        setenv("UNREAL_POC048_ASYNC", "0", 1);
+        TTDPieceStore sync;
+        setenv("UNREAL_POC048_ASYNC", mode, 1);
+        TTDPieceStore async;
+        unsetenv("UNREAL_POC048_ASYNC");
+        ASSERT_EQ(sync.AsyncMode(), 0);
+        ASSERT_NE(async.AsyncMode(), 0);
+
+        // 16 pieces, 400 frames: a few bytes, a block, noise, zero, back to old content; chains reach the limit
+        constexpr int kPieces = 16;
+        std::vector<std::vector<uint8_t>> content(kPieces, std::vector<uint8_t>(kTTDPieceSize, 0));
+        std::vector<TTDPieceId> liveS(kPieces, TTDPieceStore::kNone), liveA(kPieces, TTDPieceStore::kNone);
+        std::vector<TTDPieceId> idsS, idsA;
+        uint32_t x = 12345;
+        auto rnd = [&] { x = x * 1664525u + 1013904223u; return x >> 8; };
+        for (int frame = 0; frame < 400; ++frame)
+        {
+            for (int p = 0; p < kPieces; ++p)
+            {
+                std::vector<uint8_t> next = content[p];
+                switch (rnd() % 6)
+                {
+                    case 0: break;                                                     // unchanged
+                    case 1: next[rnd() % kTTDPieceSize] ^= uint8_t(1 + rnd() % 255); break;   // one byte
+                    case 2: { const uint32_t at = rnd() % (kTTDPieceSize - 600);       // a block
+                              for (uint32_t k = 0; k < 600; ++k) next[at + k] = uint8_t(rnd()); } break;
+                    case 3: next = Noise(rnd()); break;                                // everything
+                    case 4: std::fill(next.begin(), next.end(), 0); break;             // zero
+                    default: for (uint32_t k = 0; k < kTTDPieceSize; k += 7) next[k] = uint8_t(frame); break;
+                }
+                auto step = [&](TTDPieceStore& s, std::vector<TTDPieceId>& live, std::vector<TTDPieceId>& ids) {
+                    const TTDPieceId prev = live[p];
+                    const TTDPieceId id = prev == TTDPieceStore::kNone ? s.InternFirst(next.data())
+                                                                        : s.Intern(prev, content[p].data(), next.data());
+                    ids.push_back(id);
+                    if (prev != TTDPieceStore::kNone)
+                        s.Release(prev);   // the history keeps only the current version: frees and reuses ids
+                    live[p] = id;
+                };
+                step(sync, liveS, idsS);
+                step(async, liveA, idsA);
+                content[p] = next;
+            }
+            async.FlushAsync();
+        }
+        async.SettleAll();
+        ASSERT_EQ(idsS, idsA) << "mode " << mode;
+        std::vector<uint8_t> a(kTTDPieceSize), b(kTTDPieceSize);
+        for (int p = 0; p < kPieces; ++p)
+        {
+            const TTDPieceId s = liveS[p], t = liveA[p];
+            EXPECT_EQ(sync.EncodingOf(s), async.EncodingOf(t));
+            EXPECT_EQ(sync.DepthOf(s), async.DepthOf(t));
+            EXPECT_EQ(sync.BaseOf(s), async.BaseOf(t));
+            EXPECT_EQ(sync.CrcOf(s), async.CrcOf(t));
+            ASSERT_EQ(sync.PayloadSize(s), async.PayloadSize(t));
+            if (sync.PayloadSize(s))
+                EXPECT_EQ(0, std::memcmp(sync.PayloadData(s), async.PayloadData(t), sync.PayloadSize(s)));
+            ASSERT_TRUE(sync.Decode(s, a.data()));
+            ASSERT_TRUE(async.Decode(t, b.data()));
+            EXPECT_EQ(a, b);
+            EXPECT_EQ(a, content[p]);
+        }
+        EXPECT_EQ(sync.LiveVersions(), async.LiveVersions());
+        EXPECT_EQ(sync.PayloadBytes(), async.PayloadBytes());
+        EXPECT_EQ(sync.GetWork().compressCalls, async.GetWork().compressCalls);
+    }
+}
+}  // namespace
