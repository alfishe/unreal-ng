+/// POC 048: recording with a look back every 10th frame: seek 25 frames back, return to the end, record on.
+/// The seek reads the history right after a capture, the case that waits on pieces the worker has not packed
+BENCHMARK_DEFINE_F(FrameBenchmarkFixture, BM_Frame_TTD_SeekWhileRecording)(benchmark::State& state)
+{
+    if (!mainloop || !ttd)
+    {
+        state.SkipWithError("Not initialized");
+        return;
+    }
+
+    EnableTTD(false);
+    for (int i = 0; i < 30; ++i)
+        mainloop->RunFramePublic();
+
+    uint64_t n = 0, failed = 0;
+    for (auto _ : state)
+    {
+        mainloop->RunFramePublic();
+        if (++n % 10 == 0)
+        {
+            const ttd::TTDTimePoint end = ttd->SessionEndPosition();
+            ttd::TTDTimePoint back{};
+            back.frame = end.frame - 25;
+            if (!ttd->SeekTo(back) || !ttd->ResumeRecordingFrom(end))
+                ++failed;
+        }
+    }
+    state.counters["failed"] = static_cast<double>(failed);
+    state.SetItemsProcessed(state.iterations());
+}
+BENCHMARK_REGISTER_F(FrameBenchmarkFixture, BM_Frame_TTD_SeekWhileRecording)
+    ->Iterations(1000)
+    ->Unit(benchmark::kMicrosecond);
+
