diff --git a/core/src/debugger/ttd/poc048counters.h b/core/src/debugger/ttd/poc048counters.h
new file mode 100644
index 000000000..9eba17607
--- /dev/null
+++ b/core/src/debugger/ttd/poc048counters.h
@@ -0,0 +1,26 @@
+#pragma once
+// POC 048 (branch only): where a recording's emulation-thread time goes. Totals over the process, printed at exit
+// when UNREAL_POC048 is set (tools/poc/048-ttd-async-compress)
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace ttd::poc048
+{
+struct Counters
+{
+    std::atomic<uint64_t> allCompressNs{0}, allCompressCalls{0}, allCompressBytes{0};
+    std::atomic<uint64_t> pieceCompressNs{0}, pieceCompressCalls{0};
+    std::atomic<uint64_t> internNs{0}, internCalls{0};
+    std::atomic<uint64_t> captureNs{0}, captures{0};
+    std::atomic<uint64_t> workerNs{0}, handoffNs{0}, queued{0}, waitNs{0}, waits{0}, applyNs{0}, peakPendingBytes{0};
+};
+Counters& Get();
+
+inline uint64_t NowNs()
+{
+    return static_cast<uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+            .count());
+}
+}  // namespace ttd::poc048
