+void TTDPieceStore::Harvest()
+{
+    if (!_async)
+        return;
+    while (!_async->fifo.empty())
+    {
+        Job& front = *_async->fifo.front();
+        if (!front.applied)
+        {
+            if (!front.done.load(std::memory_order_acquire))
+                return;
+            Apply(front);
+        }
+        _async->fifo.pop_front();
+    }
+}
