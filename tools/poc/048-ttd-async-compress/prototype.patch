+// POC 048 stage 3: one compression context reused across calls gives the bytes of a fresh context per call
+TEST(TTDCompressionPoc048_Test, ReusedContextGivesTheSameBytes)
+{
+    ZSTD_CCtx* cctx = ZSTD_createCCtx();
+    ASSERT_NE(cctx, nullptr);
+    uint32_t x = 7;
+    auto rnd = [&] { x = x * 1664525u + 1013904223u; return x >> 8; };
+    for (int i = 0; i < 300; ++i)
+    {
+        // sizes of pieces, journal and coverage blocks; content from sparse to noise
+        const size_t sizes[] = {4096, 4096, 4096, 1000, 16384, 65536, 37};
+        const size_t size = sizes[i % 7];
+        std::vector<uint8_t> src(size, 0);
+        const uint32_t density = 1 + rnd() % 64;
+        for (size_t k = 0; k < size; ++k)
+            if (rnd() % 64 < density)
+                src[k] = static_cast<uint8_t>(rnd() % (1 + i % 256));
+        const size_t bound = ZSTD_compressBound(size);
+        std::vector<uint8_t> a(bound), b(bound);
+        const size_t na = ZSTD_compress(a.data(), bound, src.data(), size, ttd::codec::kDefaultZstdLevel);
+        const size_t nb = ZSTD_compressCCtx(cctx, b.data(), bound, src.data(), size, ttd::codec::kDefaultZstdLevel);
+        ASSERT_FALSE(ZSTD_isError(na));
+        ASSERT_EQ(na, nb) << "input " << i;
+        ASSERT_EQ(0, std::memcmp(a.data(), b.data(), na)) << "input " << i;
+    }
+    ZSTD_freeCCtx(cctx);
+}
