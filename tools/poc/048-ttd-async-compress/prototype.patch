+void TTDPieceStore::SettleAll() const
+{
+    if (!_async)
+        return;
+    auto* self = const_cast<TTDPieceStore*>(this);
+    while (!self->_async->fifo.empty())
+    {
+        Job& front = *self->_async->fifo.front();
+        if (!front.applied)
+        {
+            self->WaitFor(front);
+            self->Apply(front);
+        }
+        self->_async->fifo.pop_front();
+    }
