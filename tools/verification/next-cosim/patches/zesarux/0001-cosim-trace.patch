+/* Co-simulation trace sink (unreal-ng tools/verification/next-cosim). Not part of upstream ZEsarUX.
+   One text line per event, see trace-format.md:  <seq> <KIND> <addr> <value> <pc>
+   Driven by environment variables; with COSIM_TRACE unset every hook is one mask test.
+   The implementation lives at the end of machines/tbblue.c */
+#ifndef COSIM_TRACE_H
+#define COSIM_TRACE_H
+
+#include <stdio.h>
+
+#define COSIM_NRW  1
+#define COSIM_NRR  2
+#define COSIM_POUT 4
+#define COSIM_PIN  8
+#define COSIM_MMU  16
+#define COSIM_IRQ  32
+#define COSIM_PCS  64
+#define COSIM_FRM  128
+
+extern unsigned int cosim_mask;
+extern unsigned int cosim_pc;
+
+void cosim_nr(int write,unsigned int reg,unsigned int val);
+void cosim_port(int write,unsigned int port,unsigned int val);
+void cosim_irq(unsigned int vec);
+void cosim_instruction(unsigned int pc);
+void cosim_frame(void);
+
+#endif
