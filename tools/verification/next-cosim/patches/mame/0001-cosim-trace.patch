+void specnext_state::cosim_slot(u8 bank, u16 a)
+{
+	const u8 page = (a >= 0x20 && a < 0x20 + 0xe0) ? (a - 0x20) : 0xff;
+	static u8 seen = 0;
+	const bool first = !BIT(seen, bank);
+	seen |= 1 << bank;
+	if (first || cosim::g.mmu[bank] != page)
+	{
+		cosim::g.mmu[bank] = page;
+		cosim_pc();
+		cosim::mmuSlot(bank, page);
+	}
+}
+
+void specnext_state::cosim_dump()
+{
+	if (cosim::g.dumpDir.empty()) return;
+	if (cosim::g.f) std::fflush(cosim::g.f);
+	FILE* d = std::fopen((cosim::g.dumpDir + "/state.txt").c_str(), "w");
+	if (d)
+	{
+		std::fprintf(d, "emulator mame\nframes %llu\n", static_cast<unsigned long long>(cosim::g.frame));
+		std::fprintf(d, "regs PC=%04X SP=%04X AF=%04X BC=%04X DE=%04X HL=%04X AF2=%04X BC2=%04X DE2=%04X HL2=%04X IX=%04X IY=%04X I=%02X R=%02X IM=%d IFF1=%d IFF2=%d HALT=%d\n",
+			unsigned(m_maincpu->state_int(Z80_PC)), unsigned(m_maincpu->state_int(Z80_SP)), unsigned(m_maincpu->state_int(Z80_AF)), unsigned(m_maincpu->state_int(Z80_BC)), unsigned(m_maincpu->state_int(Z80_DE)), unsigned(m_maincpu->state_int(Z80_HL)),
+			unsigned(m_maincpu->state_int(Z80_AF2)), unsigned(m_maincpu->state_int(Z80_BC2)), unsigned(m_maincpu->state_int(Z80_DE2)), unsigned(m_maincpu->state_int(Z80_HL2)), unsigned(m_maincpu->state_int(Z80_IX)), unsigned(m_maincpu->state_int(Z80_IY)),
+			unsigned(m_maincpu->state_int(Z80_I)), unsigned(m_maincpu->state_int(Z80_R)), int(m_maincpu->state_int(Z80_IM)), int(m_maincpu->state_int(Z80_IFF1)), int(m_maincpu->state_int(Z80_IFF2)), int(m_maincpu->state_int(Z80_HALT)));
+		for (int i = 0; i < 8; i++)
+			std::fprintf(d, "mmu %d %02X\n", i, cosim::g.mmu[i]);
+		for (int i = 0; i < 256; i++)
+			std::fprintf(d, "nr %02X %02X\n", i, m_next_regs.read_byte(i));
+		std::fclose(d);
+	}
+	machine().video().save_active_screen_snapshots();
+	machine().schedule_exit();
+}
