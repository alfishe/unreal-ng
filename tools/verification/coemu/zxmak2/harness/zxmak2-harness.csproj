<Project Sdk="Microsoft.NET.Sdk">
  <!-- the headless runner; the engine is ZXMAK2's own, from ../engine (built from ZXMAK2_DIR) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>zxmak2-harness</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <ZxSrc>$(ZXMAK2_DIR)/src</ZxSrc>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../engine/ZXMAK2.Hardware.csproj" />
    <ProjectReference Include="../engine/ZXMAK2.Engine.csproj" />
    <ProjectReference Include="../engine/ZXMAK2.Engine.Cpu.csproj" />
    <ProjectReference Include="../engine/ZXMAK2.Host.csproj" />
    <ProjectReference Include="../engine/ZXMAK2.Hardware.Circuits.csproj" />
    <ProjectReference Include="../engine/ZXMAK2.Dependency.csproj" />
    <ProjectReference Include="../engine/ZXMAK2.Logging.csproj" />
  </ItemGroup>
  <!-- what the engine loads next to its assemblies, as in ZXMAK2's own build output:
       the stock machines, the keyboard map and the ROM pack -->
  <ItemGroup>
    <None Include="$(ZxSrc)/ZXMAK2/machines.config" Link="machines.config" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(ZxSrc)/ZXMAK2/ROMS.PAK" Link="ROMS.PAK" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(ZxSrc)/ZXMAK2.Host/Keyboard.config" Link="Keyboard.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
