+    for (int s = 0; s < 8; s++)
+        std::fprintf(d, "mmu %d %02X\n", s, mmu_.is_slot_rom(s) ? 0xFF : mmu_.get_effective_page(s));
+    for (int i = 0; i < 256; i++)
+        std::fprintf(d, "nr %02X %02X\n", i, nextreg_.peek(static_cast<uint8_t>(i)));
+    std::fclose(d);
+}
