+void Emulator::cosim_poll_mmu()
+{
+    for (int s = 0; s < 8; s++) {
+        const uint8_t p = mmu_.is_slot_rom(s) ? 0xFF : mmu_.get_effective_page(s);
+        if (!cosim::g.mmuInit || cosim::g.mmu[s] != p) {
+            cosim::g.mmu[s] = p;
+            cosim::mmuSlot(s, p);
+        }
+    }
+    cosim::g.mmuInit = true;
+}
+
+void Emulator::cosim_dump()
+{
+    if (cosim::g.dumpDir.empty()) return;
+    if (cosim::g.f) std::fflush(cosim::g.f);
+    FILE* d = std::fopen((cosim::g.dumpDir + "/state.txt").c_str(), "w");
+    if (!d) return;
+    const Z80Registers& r = cpu_.registers();
+    std::fprintf(d, "emulator jnext\nframes %llu\n", static_cast<unsigned long long>(cosim::g.frame));
+    std::fprintf(d, "regs PC=%04X SP=%04X AF=%04X BC=%04X DE=%04X HL=%04X AF2=%04X BC2=%04X DE2=%04X HL2=%04X IX=%04X IY=%04X I=%02X R=%02X IM=%d IFF1=%d IFF2=%d HALT=%d\n",
