+// Co-simulation trace sink (unreal-ng tools/machines/next/cosim). Not part of upstream jnext.
+// One text line per event, see trace-format.md:  <seq> <KIND> <addr> <value> <pc>
+// Everything is driven by environment variables; with COSIM_TRACE unset every hook is a single mask test.
+#pragma once
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace cosim {
+
+enum Kind : uint32_t { NRW = 1, NRR = 2, POUT = 4, PIN = 8, MMU = 16, IRQ = 32, PCS = 64, FRM = 128 };
+
+struct State {
+    FILE* f = nullptr;
+    uint64_t seq = 0;
+    uint32_t mask = 0;          // enabled kinds (0 = tracing off)
+    uint16_t pc = 0;            // PC of the instruction being executed
+    uint64_t frame = 0;         // completed frames
+    uint32_t pcsEvery = 0;      // PC sample every N instructions (0 = off)
+    uint64_t pcsCount = 0;
+    std::vector<std::pair<uint64_t, uint64_t>> windows;  // [first, last) frames with a PCS per instruction
+    bool inWindow = false;
+    bool portSkip[256] = {};    // low port byte to leave out (SPI data is noisy)
+    long dumpFrame = -1;        // frame count after which the state dump is written
+    std::string dumpDir;
+    uint8_t mmu[8] = {};        // last reported MMU slots
+    bool mmuInit = false;
+
+    State()
+    {
+        const char* path = std::getenv("COSIM_TRACE");
+        const char* dump = std::getenv("COSIM_DUMP");
+        if (const char* fr = std::getenv("COSIM_FRAMES"))
+            dumpFrame = std::atol(fr);
+        if (dump)
+            dumpDir = dump;
+        if (!path || !*path)
+            return;
+        f = std::fopen(path, "w");
+        if (!f)
+            return;
+        std::setvbuf(f, nullptr, _IOFBF, 1 << 20);
+        mask = NRW | NRR | POUT | PIN | MMU | IRQ | FRM;
+        if (const char* k = std::getenv("COSIM_KINDS")) {
+            mask = 0;
+            std::string s(k);
+            const char* names[] = {"NRW", "NRR", "POUT", "PIN", "MMU", "IRQ", "PCS", "FRM"};
+            for (int i = 0; i < 8; i++)
+                if (s.find(names[i]) != std::string::npos)
+                    mask |= 1u << i;
+        }
+        if (const char* p = std::getenv("COSIM_PCS"))
+            pcsEvery = static_cast<uint32_t>(std::atol(p));
+        if (pcsEvery)
+            mask |= PCS;
+        if (const char* w = std::getenv("COSIM_PCWIN")) {  // "start:count,start:count"
+            std::string s(w);
+            size_t i = 0;
+            while (i < s.size()) {
+                size_t c = s.find(':', i), e = s.find(',', i);
+                if (e == std::string::npos)
+                    e = s.size();
+                if (c != std::string::npos && c < e) {
+                    uint64_t a = std::strtoull(s.c_str() + i, nullptr, 10);
+                    uint64_t n = std::strtoull(s.c_str() + c + 1, nullptr, 10);
+                    windows.push_back({a, a + n});
+                }
+                i = e + 1;
+            }
+            if (!windows.empty())
+                mask |= PCS;
+        }
+        if (const char* sk = std::getenv("COSIM_PORT_SKIP")) {  // "eb,e7"
+            std::string s(sk);
+            size_t i = 0;
+            while (i < s.size()) {
+                size_t e = s.find(',', i);
+                if (e == std::string::npos)
+                    e = s.size();
+                portSkip[std::strtoul(s.c_str() + i, nullptr, 16) & 0xFF] = true;
+                i = e + 1;
+            }
+        }
+    }
+    ~State()
+    {
+        if (f)
+            std::fclose(f);
+    }
+};
+
+inline State g;
+
+inline bool on(Kind k) { return (g.mask & k) != 0; }
+
+inline void nr(bool write, uint8_t reg, uint8_t val)
+{
+    std::fprintf(g.f, "%llu %s %02X %02X %04X\n", static_cast<unsigned long long>(g.seq++), write ? "NRW" : "NRR", reg, val, g.pc);
+}
+
+// Ports 0x243B / 0x253B are reported as NRW / NRR only
+inline void port(bool write, uint16_t p, uint8_t val)
+{
+    if (p == 0x243B || p == 0x253B || g.portSkip[p & 0xFF])
+        return;
+    std::fprintf(g.f, "%llu %s %04X %02X %04X\n", static_cast<unsigned long long>(g.seq++), write ? "POUT" : "PIN", p, val, g.pc);
+}
+
+inline void irq(uint8_t vec, uint16_t pcBefore)
+{
+    std::fprintf(g.f, "%llu IRQ %02X %02X %04X\n", static_cast<unsigned long long>(g.seq++), vec, 0, pcBefore);
+}
+
+inline void mmuSlot(int slot, uint8_t page)
+{
+    std::fprintf(g.f, "%llu MMU %d %02X %04X\n", static_cast<unsigned long long>(g.seq++), slot, page, g.pc);
+}
+
+inline void pcs(uint16_t pcv)
+{
+    std::fprintf(g.f, "%llu PCS %04X 00 %04X\n", static_cast<unsigned long long>(g.seq++), pcv, pcv);
+}
+
+inline void frame()
+{
+    g.frame++;
+    g.inWindow = false;
+    for (auto& w : g.windows)
+        if (g.frame >= w.first && g.frame < w.second)
+            g.inWindow = true;
+    if (g.mask & FRM)
+        std::fprintf(g.f, "%llu FRM %llu 00 %04X\n", static_cast<unsigned long long>(g.seq++), static_cast<unsigned long long>(g.frame), g.pc);
+}
+
+// Called once per instruction before it executes
+inline void instruction(uint16_t pcv)
+{
+    g.pc = pcv;
+    if (g.mask & PCS) {
+        if (g.inWindow || (g.pcsEvery && (++g.pcsCount % g.pcsEvery) == 0))
+            pcs(pcv);
+    }
+}
+
+}  // namespace cosim
