# unreal-ng: access for the logged-in user to the raw HID (hidraw) nodes of the controllers the emulator reads or
# writes beyond what evdev gives (the kernel drivers are preferred: hidraw only where they have no path) (docs/inprogress/2026-10-17-controller-manager/research-host-apis.md §3.3), and to
# the light bars' LED class files.
#
# Install:
#   sudo cp data/controllers/70-unreal-ng.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger
# then reconnect the device.
#
# TAG+="uaccess" gives the user of the active local session an ACL on the node (systemd-logind), so no group
# membership and no world-writable node are needed. The file must sort before 73-seat-late.rules, which applies the
# tag: hence 70-.

# Xbox Elite Wireless Controller Series 2 over Bluetooth (Classic 045E:0B05, LE 045E:0B22): read access for the
# paddles P1-P4 and the onboard profile, which evdev does not report, and write access for the rumble (output report 3,
# with the impulse triggers) where the kernel driver offers no FF_RUMBLE (hid-generic through BlueZ's uhid; with
# hid-microsoft or xpadneo the emulator drives the motors through evdev). Over USB the pad is xpad's and has no hidraw
# node.
KERNEL=="hidraw*", KERNELS=="*045E:0B05*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*045E:0B22*", MODE="0660", TAG+="uaccess"

# The other Xbox One / Series pads over Bluetooth: write access for the rumble (output report 3) where the kernel driver
# offers no FF_RUMBLE. Xbox One S (045E:02E0, 02FD, LE firmware 0B20), Xbox Wireless Controller (Series X|S, LE 0B13),
# Xbox Adaptive Controller (045E:0B0C, LE 0B21). Ids: Linux drivers/hid/hid-ids.h (02FD, 0B20, 0B13, 0B05, 0B22) and
# SDL src/joystick/usb_ids.h (all of them, incl. 02E0, 0B0C, 0B21).
KERNEL=="hidraw*", KERNELS=="*045E:02E0*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*045E:02FD*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*045E:0B20*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*045E:0B13*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*045E:0B0C*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*045E:0B21*", MODE="0660", TAG+="uaccess"

# Microsoft Surface Dial (045E:091B, Bluetooth LE): write access for its clicks (output report 1) and detents
# (feature report 1); the input node too, which is neither a joystick nor a keyboard, so the default rules may leave it
# to the input group.
KERNEL=="hidraw*", KERNELS=="*045E:091B*", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/vendor}=="045e", ATTRS{id/product}=="091b", MODE="0660", TAG+="uaccess"

# PlayStation pads: DualSense (054C:0CE6), DualSense Edge (0DF2), DualShock 4 (05C4, 09CC, the wireless adapter 0BA0).
# Write access for what hid-playstation does not drive: a DualSense's adaptive triggers (output report 2 / 0x31 with
# only the trigger flags; the kernel keeps the motors, the light bar and the player LEDs). Read access for the Edge's
# paddles and Fn buttons on kernels before 7.2, whose hid-playstation does not report them. Under hid-generic (no
# hid-playstation: an old kernel, the module not loaded) the emulator talks the pad's whole protocol through the node,
# as on macOS.
KERNEL=="hidraw*", KERNELS=="*054C:0CE6*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:0DF2*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:05C4*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:09CC*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:0BA0*", MODE="0660", TAG+="uaccess"

# Nintendo Switch Pro controller (057E:2009), Joy-Con (L) / (R) (2006, 2007), the charging grip (200E): write access
# for the HD rumble (report 0x10 at the effect's frequencies) beside hid-nintendo, whose FF_RUMBLE plays fixed
# 160 / 320 Hz. Under hid-generic the whole protocol, as for the PlayStation pads. joycond (if installed) takes the
# Joy-Cons' evdev nodes for its combined device: the emulator then reads that one.
KERNEL=="hidraw*", KERNELS=="*057E:2009*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*057E:2006*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*057E:2007*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*057E:200E*", MODE="0660", TAG+="uaccess"
# Nintendo Switch Online SNES / N64 / Sega Genesis controllers (057E:2017, 2019, 201E): hid-nintendo serves them from
# Linux 6.8 (the N64 pad's HD rumble through hidraw); before 6.8 hid-generic binds them and the whole protocol goes
# through hidraw, as for the Pro controller.
KERNEL=="hidraw*", KERNELS=="*057E:2017*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*057E:2019*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*057E:201E*", MODE="0660", TAG+="uaccess"
# Nintendo GameCube Controller Adapter for Wii U / Switch (057E:0337): no kernel driver gives it an input device (its
# reports are on the Game Controls page); the emulator writes its start report 0x13 and reads the four ports' report
# 0x21 through hidraw.
KERNEL=="hidraw*", KERNELS=="*057E:0337*", MODE="0660", TAG+="uaccess"


# DualSense / DualSense Edge (hid-playstation: one multicolor LED "<input>:rgb:indicator") and DualShock 4
# (hid-playstation since Linux 6.2, hid-sony before: "<prefix>:red", ":green", ":blue"): write access to the light
# bar's LED class files for the `light` verb. Attributes in sysfs take no ACL, so uaccess does not reach them: their
# mode is opened instead (a light bar's colour is all they set). The player LEDs stay the kernel's.
SUBSYSTEM=="leds", DRIVERS=="playstation", KERNEL=="*:rgb:indicator", RUN+="/bin/chmod 0666 /sys%p/brightness /sys%p/multi_intensity"
SUBSYSTEM=="leds", DRIVERS=="playstation", KERNEL=="*:red|*:green|*:blue", RUN+="/bin/chmod 0666 /sys%p/brightness"
SUBSYSTEM=="leds", DRIVERS=="sony", KERNEL=="*:red|*:green|*:blue", RUN+="/bin/chmod 0666 /sys%p/brightness"
