#version 330

uniform mat4 LIBRA_UNIFORM_MVP;

uniform vec4 LIBRA_UNIFORM_OutputSize;
uniform vec4 LIBRA_UNIFORM_OriginalSize;
uniform vec4 LIBRA_UNIFORM_SourceSize;
uniform float LIBRA_UNIFORM_PRESET_OPTION;
uniform float LIBRA_UNIFORM_BEAM_MIN_WIDTH;
uniform float LIBRA_UNIFORM_BEAM_MAX_WIDTH;
uniform float LIBRA_UNIFORM_SCANLINES_STRENGTH;
uniform float LIBRA_UNIFORM_SCANLINES_SHAPE;
uniform float LIBRA_UNIFORM_SHARPNESS_HACK;
uniform float LIBRA_UNIFORM_SCANLINES_CUTOFF;
uniform float LIBRA_UNIFORM_SCANLINES_HIRES;
uniform float LIBRA_UNIFORM_IR_SCALE;
uniform float LIBRA_UNIFORM_CRT_ANTI_RINGING;
uniform float LIBRA_UNIFORM_VSCANLINES;
uniform float LIBRA_UNIFORM_BRIGHTBOOST;

layout(location = 0) in vec4 Position;
out vec2 LIBRA_VARYING_0;
layout(location = 1) in vec2 TexCoord;
out vec4 LIBRA_VARYING_1;
out vec2 LIBRA_VARYING_2;
out vec2 LIBRA_VARYING_3;
out vec4 LIBRA_VARYING_4;
out float LIBRA_VARYING_5;

vec4 get_beam_profile()
{
    vec4 bp = vec4(((-0.1599999964237213134765625) * LIBRA_UNIFORM_SCANLINES_SHAPE) + LIBRA_UNIFORM_SCANLINES_STRENGTH, LIBRA_UNIFORM_BEAM_MIN_WIDTH, LIBRA_UNIFORM_BEAM_MAX_WIDTH, LIBRA_UNIFORM_SCANLINES_SHAPE);
    if (LIBRA_UNIFORM_PRESET_OPTION == 1.0)
    {
        bp = vec4(0.7200000286102294921875, 0.7200000286102294921875, 1.0, 1.0);
    }
    if (LIBRA_UNIFORM_PRESET_OPTION == 2.0)
    {
        bp = vec4(0.579999983310699462890625, 0.7200000286102294921875, 1.0, 1.0);
    }
    if (LIBRA_UNIFORM_PRESET_OPTION == 3.0)
    {
        bp = vec4(0.579999983310699462890625, 0.86000001430511474609375, 1.0, 0.0);
    }
    if (LIBRA_UNIFORM_PRESET_OPTION == 4.0)
    {
        bp = vec4(0.579999983310699462890625, 0.86000001430511474609375, 1.0, 1.0);
    }
    if (LIBRA_UNIFORM_PRESET_OPTION == 5.0)
    {
        bp = vec4(0.579999983310699462890625, 0.7200000286102294921875, 1.0, 1.0);
    }
    return bp;
}

void main()
{
    gl_Position = LIBRA_UNIFORM_MVP * Position;
    LIBRA_VARYING_0 = TexCoord * 1.00010001659393310546875;
    vec2 pre_offset = vec2(LIBRA_UNIFORM_SHARPNESS_HACK, 1.0 / LIBRA_UNIFORM_IR_SCALE);
    pre_offset = mix(pre_offset, pre_offset.yx, vec2(LIBRA_UNIFORM_VSCANLINES));
    LIBRA_VARYING_1 = vec4(pre_offset, vec2(1.0) / pre_offset) * LIBRA_UNIFORM_SourceSize;
    LIBRA_VARYING_2 = mix(vec2(LIBRA_VARYING_1.z, 0.0), vec2(0.0, LIBRA_VARYING_1.w), vec2(LIBRA_UNIFORM_VSCANLINES));
    LIBRA_VARYING_3 = mix(vec2(0.0, LIBRA_VARYING_1.w), vec2(LIBRA_VARYING_1.z, 0.0), vec2(LIBRA_UNIFORM_VSCANLINES));
    LIBRA_VARYING_4 = get_beam_profile();
    LIBRA_VARYING_5 = float(mix(LIBRA_VARYING_1.y, LIBRA_VARYING_1.x, LIBRA_UNIFORM_VSCANLINES) <= LIBRA_UNIFORM_SCANLINES_CUTOFF);
}
