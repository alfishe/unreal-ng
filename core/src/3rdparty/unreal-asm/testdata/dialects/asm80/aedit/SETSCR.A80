;Subprograms

set_vmode
		ld	a,#82
		ld	bc,#50
	  	rst	#10
		ret


open_video_mem
		push	af
		in	a,(win1)
		ld	(previous),a
		ld	a,#50
		out 	(win1),a
		pop	af
		ret

open_video_mem1
		push	af
		in	a,(win1)
		ld	(previous),a
		ld	a,#58
		out 	(win1),a
		pop	af
		ret

close_video_mem
		push	af
		ld	a,(previous)
		out	(win1),a
		pop	af
		ret


previous	defb	0

clear_screen
		ld	b,a
		and	%00001111
		rlca
		rlca
		rlca
		rlca
		or	b
		ld	(clear_color),a
		in	a,(win1)
		push	af
		ld	a,#50
		out	(win1),a
		ld	b,0
clear_screen1	push	bc
		ld	a,b
		out	(port_y),a
		ld	hl,#4000
		ld	de,#4001
		ld	bc,320
		ld	a,0
clear_color	equ	$-1
		ld	(hl),a
		ldir
		pop	bc
		djnz	clear_screen1
		pop	af
		out	(win1),a
		ret


wait_a_key
		ld	c,#30
		rst	#10
		ret

wait_q_key
		ld	c,#31
		rst	#10
		jr	z,wait_q_key
		cp	"Q"
		ret	z
		cp	"q"
		ret	z
		jp	wait_q_key

wait_a_click
		push	af
