; number spellings and operators
        org     100h
        defb    42, 2Ah, 0x2A, $2A, 101010b, 52o, 52q, 42d
        defw    1234h, 0x1234, $1234
        defb    'A', "B", 'hello'
        defw    'LH'
        defb    1+2*3, (1+2)*3, 7 mod 3, 7 % 3, 1 shl 4, 256 shr 4, 0ffh and 0fh, 1 or 2, 3 xor 1
        defb    not 0 and 0ffh, low 1234h, high 1234h, -1 and 0ffh
        defb    1 < 2, 2 > 3, 3 == 3, 3 != 3, 5 >= 5, 5 <= 4
