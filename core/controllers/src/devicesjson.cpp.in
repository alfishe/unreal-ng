// Generated by core/controllers/CMakeLists.txt from data/controllers/devices.json: do not edit. MSVC takes up to
// 16380 bytes in one literal, so the CMake step cuts the database at line ends into pieces of at most 16000
#include <string>

#include "devicedatabase.h"

namespace controllers
{

const char* BuiltinDevicesJson()
{
    static const char* const kPieces[] = {
@DEVICES_JSON_PIECES@    };
    static const std::string json = [] {
        std::string all;
        for (const char* piece : kPieces)
            all += piece;
        return all;
    }();
    return json.c_str();
}

}  // namespace controllers
