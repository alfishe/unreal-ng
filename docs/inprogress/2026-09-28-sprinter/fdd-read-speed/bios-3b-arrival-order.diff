--- a/src/bios/exp/EXTENDED/FDD_DRIVER.asm
+++ b/src/bios/exp/EXTENDED/FDD_DRIVER.asm
@@ -201,8 +201,12 @@ FDD_5x_LONG_READ:
 		 PUSH	BC
 		 CALL	SEEK
 		 POP	BC
-		EXX 
-		PUSH	DE
+		 BIT	5,B		; a write: sector by sector, as before
+		EXX
+		JR	NZ,.IN_ORDER
+		CALL	RUN_FITS	; two or more sectors of this track, in this page?
+		JP	NC,.ARRIVE	;  yes: in the order they come under the head
+.IN_ORDER:	PUSH	DE
