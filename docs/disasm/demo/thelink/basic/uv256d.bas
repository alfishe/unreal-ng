10 CLEAR 32767
40 LET n=32768
50 FOR y=63.5 TO 0.5 STEP -1
60 FOR x=31.5 TO 0.5 STEP -1
70 LET v=-(((y/64)^1)*64*(160-(x*x)/64)/8192)*64
80 LET u=-(((x/64)^1)*64*(160-(y*y)/64)/8192)*64
85 POKE n,u: POKE n+1,v: LET n=n+2
90 REM PRINT u,v
100 NEXT x: NEXT y
110 RANDOMIZE USR 15619: REM : SAVE "uv256d" CODE 32768,n-32768
