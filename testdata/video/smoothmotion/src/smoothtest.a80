/*
smoothtest: synthetic motion for the smooth-motion verification (tools/verification/smoothmotion).

Every frame shows one new step of every object, computed from its own frame counter only, so the motion is exactly
known: double-buffered on the 128K screens (draw into the hidden one, switch at the next interrupt), nothing
flickers. Positions in 1/16 px.

Scenes (one file each, smooth-<name>.a80, defines SCENE and the file names and includes this one):
  1 speeds   eight balls, 0.5 1 1.5 2 3 4 6 8 px per frame to the right (wrap after 192 px)
  2 scroll   text bands scrolling left 0.5 1 2 3 px per frame, two bands scrolling up 1 and 2 px per frame
  3 cadence  balls moving like games draw: 2N px every N frames (N = 1..6), 2 px every 2nd, 6 px every 2nd
  4 dots     a dot-matrix scroller on an 8 px grid (Aleste's kind) at 8 and 4 px per frame, 24 lines each
  5 mixed    different motions in the same rows: a box (Aleste's "PRESS KEY" kind) whose dashed sides run around it
             and whose text bounces up and down; two half-width text bands moving apart; a grid scrolling up next to
             a text moving left

The frame counter (word) is at #5B00, frames lost to a late picture at #5B02 (the border turns red); a test reads
both. 128K or Pentagon; the 48K ROM is paged in (its font, its IM 1 handler).
*/
                device zxspectrum128

T_BALL          equ 1
T_HBAND         equ 2           ; text, 16 lines, any whole-pixel position
T_VBAND         equ 3           ; character grid, 16 lines, scrolling up
T_DBAND         equ 4           ; dot matrix, 24 lines, positions in 4 px steps
T_BOX           equ 5           ; dashed box with bouncing text, 20 lines; position = frames
T_HL            equ 6           ; text, 16 lines, columns 4..17
T_HR            equ 7           ; text, 16 lines, columns 18..31
T_VL            equ 8           ; character grid, 16 lines, columns 4..17, scrolling up

FRAMES          equ #5B00
MISSED          equ #5B02
BASE            equ #6000       ; texture rows before shifting (up to 48 x 97 bytes)
STACK           equ #5FF0

                org #8000
start
                di
                ld sp,STACK
                ld iy,#5C3A
                im 1
                ld a,#17                ; bank 7 at #C000, screen 5 shown, 48K ROM
                ld bc,#7FFD
                out (c),a
                xor a
                out (#FE),a
                ld hl,0
                ld (FRAMES),hl
                ld (MISSED),hl

                ld hl,#4000 : call clear_screen
                ld hl,#C000 : call clear_screen

                call make_lines
                call make_tables
                call scene_setup

                ld a,#80                ; first picture into screen 7
                ld (delta),a
                call draw
                ld a,#1F                ; then show screen 7
                ld (shownext),a
                ei
                halt
                ld a,(23672)
                ld (lastint),a

; Interrupts stay on: a picture not ready by the next interrupt makes the halt wait for the one after
main
                halt
                ld a,(23672)            ; more than one interrupt since the last: red border, MISSED counts
                ld b,a
                ld a,(lastint)
                inc a
                cp b
                ld a,b
                ld (lastint),a
                jr z,.intime
                ld a,2
                out (#FE),a
                ld hl,(MISSED)
                inc hl
                ld (MISSED),hl
.intime
                ld a,(shownext)
                ld bc,#7FFD
                out (c),a
                xor %00001000
                ld (shownext),a
                ld a,(delta)
                xor #80
                ld (delta),a
                ld hl,(FRAMES)
                inc hl
                ld (FRAMES),hl
                call update
                call draw
                jr main

; HL = #4000 or #C000: pixels 0, attributes bright white on black
clear_screen
                ld d,h : ld e,l : inc de
                ld (hl),0
                ld bc,6143
                ldir
                ex de,hl
                ld d,h : ld e,l : inc de
                ld (hl),#47
                ld bc,767
                ldir
                ret

; ---------------------------------------------------------------------------------------------
; lines: 192 screen-5 line addresses
make_lines
                ld ix,lines
                ld c,0
.l              ld a,c
                and #C0
                rrca : rrca : rrca
                ld h,a
                ld a,c
                and 7
                or h
                or #40
                ld h,a
                ld a,c
                and #38
                rlca : rlca
                ld l,a
                ld (ix+0),l
                ld (ix+1),h
                inc ix : inc ix
                inc c
                ld a,c
                cp 192
                jr nz,.l
                ret

; A = line -> HL = its address in the screen being drawn; keeps BC, DE
line_addr
                ld l,a
                ld h,0
                add hl,hl
                push de
                ld de,lines
                add hl,de
                pop de
                ld a,(hl)
                inc hl
                ld h,(hl)
                ld l,a
                ld a,(delta)
                or h
                ld h,a
                ret

; A -> HL = A * 96 (DE lost)
row96
                ld l,a
                ld h,0
                add hl,hl : add hl,hl : add hl,hl : add hl,hl : add hl,hl
                ld d,h : ld e,l
                add hl,hl
                add hl,de
                ret

; ---------------------------------------------------------------------------------------------
; Every object one step on: count up to its period, then the position moves by its step and wraps
update
                ld ix,objects
.o              ld a,(ix+0)
                or a
                ret z
                inc (ix+7)
                ld a,(ix+7)
                cp (ix+6)
                jr c,.next
                ld (ix+7),0
                ld l,(ix+2) : ld h,(ix+3)
                ld e,(ix+4) : ld d,(ix+5)
                add hl,de
                ld a,(ix+0)
                cp T_BALL
                jr nz,.notball
                ld de,192*16
                or a
                sbc hl,de
                jr nc,.store
                add hl,de
                jr .store
.notball        cp T_VBAND
                jr z,.v64
                cp T_VL
                jr nz,.wide
.v64            ld a,h : and #03 : ld h,a       ; 64 lines
                jr .store
.wide           ld a,h : and #1F : ld h,a       ; 512 px
.store          ld (ix+2),l : ld (ix+3),h
.next           ld de,8
                add ix,de
                jr .o

draw
                ld ix,objects
.o              ld a,(ix+0)
                or a
                ret z
                cp T_BALL : call z,draw_ball
                ld a,(ix+0)
                cp T_HBAND : call z,draw_hband
                ld a,(ix+0)
                cp T_VBAND : call z,draw_vband
                ld a,(ix+0)
                cp T_DBAND : call z,draw_dband
                IF SCENE == 5
                ld a,(ix+0)
                cp T_BOX : call z,draw_box
                ld a,(ix+0)
                cp T_HL : call z,draw_hl
                ld a,(ix+0)
                cp T_HR : call z,draw_hr
                ld a,(ix+0)
                cp T_VL : call z,draw_vl
                ENDIF
                ld de,8
                add ix,de
                jr .o

; HL = position (1/16 px) -> HL = whole pixels
                MACRO SHR4
                srl h : rr l
                srl h : rr l
                srl h : rr l
                srl h : rr l
                ENDM

; ---------------------------------------------------------------------------------------------
; Balls: 16 x 16 at x = 48 + position, drawn 5 bytes wide from 16 px to the left of it: the two leading bytes clear
; what this screen showed two frames ago (at most 16 px back). Just after a wrap the right end is cleared too.
draw_ball
                ld l,(ix+2) : ld h,(ix+3)
                SHR4
                ld c,l                  ; x 0..191
                ld a,l
                and 7
                ld l,a
                ld h,0
                add hl,hl : add hl,hl : add hl,hl : add hl,hl
                ld d,h : ld e,l
                add hl,hl : add hl,hl
                add hl,de               ; shift * 80
                ld de,ballsh
                add hl,de
                push hl
                ld a,c
                cp 16
                call c,clear_right
                ld a,c
                rrca : rrca : rrca
                and 31
                add a,4
                ld c,a                  ; column of the first byte
                ld a,(ix+1)
                call line_addr
                ld a,l
                add a,c
                ld l,a
                ex de,hl                ; DE = screen
                pop hl                  ; HL = the shifted ball
                ld b,16
.l              push de
                ldi : ldi : ldi : ldi : ldi
                pop de
                call down_de
                djnz .l
                ret

; columns 26..31 of the ball's 16 lines to 0 (keeps C)
clear_right
                ld a,(ix+1)
                call line_addr
                ld a,l
                add a,26
                ld l,a
                ex de,hl
                ld b,16
.l              ld h,d : ld l,e
                xor a
                ld (hl),a : inc l : ld (hl),a : inc l : ld (hl),a : inc l
                ld (hl),a : inc l : ld (hl),a : inc l : ld (hl),a
                call down_de
                djnz .l
                ret

; DE = the next screen line down (any line but the last)
down_de
                inc d
                ld a,d
                and 7
                ret nz
                ld a,e
                add a,32
                ld e,a
                ret c
                ld a,d
                sub 8
                ld d,a
                ret

; Common start of the horizontal bands: whole pixels & 511 -> b_shift = px & A, HL = px / 8 + 4; DE = screen line
; (ix+1), column 4
                MACRO BAND_START mask
                ld l,(ix+2) : ld h,(ix+3)
                SHR4
                ld a,h : and 1 : ld h,a
                ld a,l : and mask : ld (b_shift),a
                srl h : rr l
                srl h : rr l
                srl h : rr l
                ld a,l
                add a,4
                ld (b_off),a
                ld a,(ix+1)
                call line_addr
                ld a,l
                add a,4
                ld l,a
                ex de,hl
                ENDM

; 28 bytes from (srcp) to DE, then DE one line down
                MACRO BLIT_LINE
                push de
                ld hl,(srcp)
                .28 ldi
                pop de
                call down_de
                ENDM

; Text band: 16 lines (font rows doubled), texture column = screen column + position
draw_hband
                BAND_START 7
                ld a,(b_shift)
                add a,a : add a,a : add a,a
                call row96s
                ld a,16
                ld (b_line),a
.l              BLIT_LINE
                ld a,(b_line)
                dec a
                ld (b_line),a
                ret z
                and 1
                jr nz,.l
                ld hl,(srcp)
                ld bc,96
                add hl,bc
                ld (srcp),hl
                jr .l

; Dot band: 24 lines, the texture shifted by 0 or 4 px
draw_dband
                BAND_START 4
                ld a,(b_shift)
                or a
                jr z,.s0
                ld a,24
.s0             call row96s
                ld a,24
                ld (b_line),a
.l              BLIT_LINE
                ld hl,(srcp)
                ld bc,96
                add hl,bc
                ld (srcp),hl
                ld a,(b_line)
                dec a
                ld (b_line),a
                jr nz,.l
                ret

; A = texture row -> srcp = htex / dtex + A * 96 + b_off (keeps DE)
row96s
                push de
                call row96
                ld de,htex              ; htex and dtex share the address
                add hl,de
                ld a,(b_off)
                ld e,a
                ld d,0
                add hl,de
                ld (srcp),hl
                pop de
                ret

; Character grid: 16 lines of a 64-line texture, scrolling up
draw_vband
                ld l,(ix+2) : ld h,(ix+3)
                SHR4
                ld a,l
                ld (b_off),a            ; first texture line 0..63
                ld l,a
                ld h,0
                add hl,hl : add hl,hl : add hl,hl : add hl,hl : add hl,hl
                ld de,vtex+4
                add hl,de
                ld (srcp),hl
                ld a,(ix+1)
                call line_addr
                ld a,l
                add a,4
                ld l,a
                ex de,hl
                ld a,16
                ld (b_line),a
.l              BLIT_LINE
                ld hl,(srcp)
                ld bc,32
                add hl,bc
                ld a,(b_off)
                inc a
                and 63
                ld (b_off),a
                jr nz,.nw
                ld bc,-64*32
                add hl,bc
.nw             ld (srcp),hl
                ld a,(b_line)
                dec a
                ld (b_line),a
                jr nz,.l
                ret

                IF SCENE == 5
; Box: a dashed frame 28 bytes wide (columns 4..31) and 20 lines high at (ix+1). Every frame the top dashes move 1 px
; right, the bottom ones 1 px left, the left side 1 px down and the right side 1 px up; inside, a text line bounces
; 0 1 2 3 3 2 1 0 px down (phase = position & 7).
draw_box
                ld l,(ix+2) : ld h,(ix+3)
                SHR4
                ld a,l
                and 7
                ld (b_shift),a
                ld e,a
                ld d,0
                ld hl,bounce
                add hl,de
                ld a,(hl)
                add a,2
                ld (b_off),a            ; the text's first line inside: 2..5
                ld hl,dashr
                add hl,de
                ld a,(hl)
                ld (b_y),a              ; the top dash byte
                ld a,(ix+1)
                call line_addr
                ld a,l
                add a,4
                ld l,a
                ex de,hl
                ld a,(b_y) : call fill28
                call down_de
                ld a,(b_y) : call fill28
                call down_de
                xor a
                ld (b_line),a
.in             push de
                ld a,(b_shift)          ; left side: on where ((line - phase) & 7) < 4
                ld c,a
                ld a,(b_line)
                sub c
                and 7
                cp 4
                ld a,0
                jr nc,.l0
                ld a,#C0
.l0             ld (de),a
                inc de
                ld a,(b_line)
                ld hl,b_off
                sub (hl)
                cp 8
                jr nc,.blank
                ld l,a                  ; text row r: tbuf + 26 r
                ld h,0
                ld b,h : ld c,l
                add hl,hl
                add hl,bc
                add hl,hl : add hl,hl
                add hl,bc
                add hl,hl
                ld bc,tbuf
                add hl,bc
                ld bc,26
                ldir
                jr .right
.blank          ld h,d : ld l,e
                ld (hl),0
                inc de
                ld bc,25
                ldir
.right          ld a,(b_shift)          ; right side: on where ((line + phase) & 7) < 4
                ld c,a
                ld a,(b_line)
                add a,c
                and 7
                cp 4
                ld a,0
                jr nc,.r0
                ld a,#03
.r0             ld (de),a
                pop de
                call down_de
                ld a,(b_line)
                inc a
                ld (b_line),a
                cp 16
                jr nz,.in
                ld a,(b_shift)          ; the bottom dashes: the top ones mirrored in time
                neg
                and 7
                ld c,a
                ld b,0
                ld hl,dashr
                add hl,bc
                ld a,(hl)
                ld (b_y),a
                call fill28
                call down_de
                ld a,(b_y)
                jp fill28

; A to 28 bytes at DE (kept)
fill28
                push de
                ld h,d : ld l,e
                ld (hl),a
                inc de
                ld bc,27
                ldir
                pop de
                ret

draw_hl         ld a,4
                jr draw_hpart
draw_hr         ld a,18
; Text band of 14 bytes from column A: like draw_hband
draw_hpart
                ld (b_col),a
                ld l,(ix+2) : ld h,(ix+3)
                SHR4
                ld a,h : and 1 : ld h,a
                ld a,l : and 7 : ld (b_shift),a
                srl h : rr l
                srl h : rr l
                srl h : rr l
                ld a,(b_col)
                add a,l
                ld (b_off),a
                ld a,(ix+1)
                call line_addr
                ld a,(b_col)
                add a,l
                ld l,a
                ex de,hl
                ld a,(b_shift)
                add a,a : add a,a : add a,a
                call row96s
                ld a,16
                ld (b_line),a
.l              push de
                ld hl,(srcp)
                ld bc,14
                ldir
                pop de
                call down_de
                ld a,(b_line)
                dec a
                ld (b_line),a
                ret z
                and 1
                jr nz,.l
                ld hl,(srcp)
                ld bc,96
                add hl,bc
                ld (srcp),hl
                jr .l

; Character grid of 14 bytes from column 4: like draw_vband
draw_vl
                ld l,(ix+2) : ld h,(ix+3)
                SHR4
                ld a,l
                ld (b_off),a
                ld l,a
                ld h,0
                add hl,hl : add hl,hl : add hl,hl : add hl,hl : add hl,hl
                ld de,vtex+4
                add hl,de
                ld (srcp),hl
                ld a,(ix+1)
                call line_addr
                ld a,l
                add a,4
                ld l,a
                ex de,hl
                ld a,16
                ld (b_line),a
.l              push de
                ld hl,(srcp)
                ld bc,14
                ldir
                pop de
                call down_de
                ld hl,(srcp)
                ld bc,32
                add hl,bc
                ld a,(b_off)
                inc a
                and 63
                ld (b_off),a
                jr nz,.nw
                ld bc,-64*32
                add hl,bc
.nw             ld (srcp),hl
                ld a,(b_line)
                dec a
                ld (b_line),a
                jr nz,.l
                ret

; The box's text: 8 font rows of 26 characters
make_tbuf
                ld de,tbuf
                ld c,0
.r              ld hl,btext
                ld b,26
.ch             push hl
                ld a,(hl)
                call glyph
                ld a,l : add a,c : ld l,a
                ld a,(hl)
                ld (de),a
                inc de
                pop hl
                inc hl
                djnz .ch
                inc c
                ld a,c
                cp 8
                jr nz,.r
                ret
                ENDIF

; ---------------------------------------------------------------------------------------------
; Tables

                IF SCENE == 1 || SCENE == 3
; The ball 8 times, shifted right by 0..7 px: 5 bytes x 16 lines each, two zero bytes first
make_balls
                ld de,ballsh
                ld c,0
.s              ld ix,ball
                ld b,16
.ln             xor a
                ld (tmp),a : ld (tmp+1),a : ld (tmp+4),a
                ld a,(ix+0) : ld (tmp+2),a
                ld a,(ix+1) : ld (tmp+3),a
                ld a,c
                or a
                jr z,.copy
                push bc
                ld b,c
.sh             ld hl,tmp+2
                srl (hl) : inc hl
                rr (hl) : inc hl
                rr (hl)
                djnz .sh
                pop bc
.copy           ld hl,tmp
                push bc
                ld bc,5
                ldir
                pop bc
                inc ix : inc ix
                djnz .ln
                inc c
                ld a,c
                cp 8
                jr nz,.s
                ret
                ENDIF

; The first 33 bytes of the 64-byte row before DE again after it (DE = row start + 64)
dup_row
                push bc
                ld h,d : ld l,e
                ld bc,-64
                add hl,bc
                ld bc,33
                ldir
                pop bc
                ret

; Rows of 97 bytes at HL (B rows) shifted left by C px into 96-byte rows at DE
shift_rows
.row            push bc
                ld b,96
.i              push bc
                push hl
                ld a,(hl)
                inc hl
                ld l,(hl)
                ld h,a
                ld a,c
                or a
                jr z,.st
                ld b,a
.sh             add hl,hl
                djnz .sh
.st             ld a,h
                ld (de),a
                inc de
                pop hl
                inc hl
                pop bc
                djnz .i
                inc hl
                pop bc
                djnz .row
                ret

; A = character -> HL = its glyph in the ROM font (DE kept)
glyph
                ld l,a
                ld h,0
                add hl,hl : add hl,hl : add hl,hl
                push de
                ld de,#3C00
                add hl,de
                pop de
                ret

                IF SCENE == 2 || SCENE == 5
; Text: 8 font rows of the 64-character message, then 8 shifts
make_htex
                ld de,BASE
                ld c,0
.r              ld hl,hmsg
                ld b,64
.ch             push hl
                ld a,(hl)
                call glyph
                ld a,l : add a,c : ld l,a
                ld a,(hl)
                ld (de),a
                inc de
                pop hl
                inc hl
                djnz .ch
                call dup_row
                inc c
                ld a,c
                cp 8
                jr nz,.r
                ld de,htex
                ld c,0
.s              ld hl,BASE
                ld b,8
                call shift_rows
                inc c
                ld a,c
                cp 8
                jr nz,.s
                ret

; Character grid: 8 character rows x 32, each character 7 on from the one before
make_vtex
                ld de,vtex
                ld a,33
                ld (vch),a
                ld c,0                  ; character row
.cr             ld a,(vch)
                ld (vstart),a
                ld b,0                  ; font row
.fr             ld a,(vstart)
                ld (vch),a
                push bc
                ld b,32
.col            push bc
                ld a,(vch)
                call glyph
                pop bc
                push bc
                ld a,l
                ld c,a
                ld a,(vrow)
                add a,c
                ld l,a
                ld a,(hl)
                ld (de),a
                inc de
                ld a,(vch)
                add a,7
                cp 127
                jr c,.ok
                sub 94
.ok             ld (vch),a
                pop bc
                djnz .col
                pop bc
                inc b
                ld a,b
                ld (vrow),a
                cp 8
                jr nz,.fr
                xor a
                ld (vrow),a
                inc c
                ld a,c
                cp 8
                jr nz,.cr
                ret

                ENDIF

                IF SCENE == 4
; Dot matrix: font rows 1..6 of the 8-character message, a dot per pixel on an 8 x 4 grid; shifts 0 and 4
make_dtex
                ld de,BASE
                xor a
                ld (dline),a
.r              ld a,(dline)
                and 3
                ld hl,dotpat
                add a,l : ld l,a
                jr nc,$+3
                inc h
                ld a,(hl)
                ld (ddot),a
                ld a,(dline)
                rrca : rrca
                and 7
                inc a
                ld (dfrow),a
                ld hl,dmsg
                ld b,8
.ch             push bc
                push hl
                ld a,(hl)
                call glyph
                ld a,(dfrow)
                add a,l : ld l,a
                ld c,(hl)
                ld b,8
.bit            ld a,(ddot)
                rl c
                jr c,.on
                xor a
.on             ld (de),a
                inc de
                djnz .bit
                pop hl
                inc hl
                pop bc
                djnz .ch
                call dup_row
                ld a,(dline)
                inc a
                ld (dline),a
                cp 24
                jr nz,.r
                ld de,dtex
                ld hl,BASE
                ld b,24
                ld c,0
                call shift_rows
                ld hl,BASE
                ld b,24
                ld c,4
                call shift_rows
                ret

                ENDIF

; ---------------------------------------------------------------------------------------------
; A = first character row, B = rows, C = attribute: both screens
attr_rows
                ld l,a
                ld h,0
                add hl,hl : add hl,hl : add hl,hl : add hl,hl : add hl,hl
                ld de,#5800
                add hl,de
.r              push bc
                push hl
                ld b,32
.c              ld (hl),c
                set 7,h
                ld (hl),c
                res 7,h
                inc hl
                djnz .c
                pop hl
                ld de,32
                add hl,de
                pop bc
                djnz .r
                ret

; HL = text (0 ends), B = character row, C = column: both screens
print2
                push hl
                push bc
                xor a
                ld (pdelta),a
                call print
                pop bc
                pop hl
                ld a,#80
                ld (pdelta),a
print
.c              ld a,(hl)
                or a
                ret z
                inc hl
                push hl
                push bc
                call glyph
                ex de,hl
                ld a,b
                and #18
                or #40
                ld h,a
                ld a,(pdelta)
                or h
                ld h,a
                ld a,b
                and 7
                rrca : rrca : rrca
                or c
                ld l,a
                ld b,8
.r              ld a,(de)
                ld (hl),a
                inc de
                inc h
                djnz .r
                pop bc
                inc c
                pop hl
                jr .c

; Labels: a list of (row, text...0), ending with #FF
labels
.n              ld a,(hl)
                cp #FF
                ret z
                ld b,a
                ld c,0
                inc hl
                push hl
                call print2
                pop hl
.skip           ld a,(hl)
                inc hl
                or a
                jr nz,.skip
                jr .n

; ---------------------------------------------------------------------------------------------
; Scenes

                IF SCENE == 1 || SCENE == 3
make_tables     jp make_balls
scene_setup
                ld hl,ball_attrs
                ld a,0
.a              ld c,(hl)
                inc hl
                push hl
                push af
                ld b,3
                call attr_rows
                pop af
                pop hl
                add a,3
                cp 24
                jr nz,.a
                ld hl,scene_labels
                jp labels
ball_attrs      db #46,#45,#44,#43,#42,#47,#46,#45
                ENDIF

                IF SCENE == 1
objects
                db T_BALL,4     : dw 0,8        : db 1,0        ; 0.5 px
                db T_BALL,28    : dw 0,16       : db 1,0        ; 1
                db T_BALL,52    : dw 0,24       : db 1,0        ; 1.5
                db T_BALL,76    : dw 0,32       : db 1,0        ; 2
                db T_BALL,100   : dw 0,48       : db 1,0        ; 3
                db T_BALL,124   : dw 0,64       : db 1,0        ; 4
                db T_BALL,148   : dw 0,96       : db 1,0        ; 6
                db T_BALL,172   : dw 0,128      : db 1,0        ; 8
                db 0
scene_labels    db 1,".5",0, 4,"1",0, 7,"1.5",0, 10,"2",0, 13,"3",0, 16,"4",0, 19,"6",0, 22,"8",0, #FF
                ENDIF

                IF SCENE == 3
objects
                db T_BALL,4     : dw 0,32       : db 1,0        ; 2 px every frame
                db T_BALL,28    : dw 0,64       : db 2,0        ; 4 px every 2nd
                db T_BALL,52    : dw 0,96       : db 3,0        ; 6 px every 3rd
                db T_BALL,76    : dw 0,128      : db 4,0        ; 8 px every 4th
                db T_BALL,100   : dw 0,160      : db 5,0        ; 10 px every 5th
                db T_BALL,124   : dw 0,192      : db 6,0        ; 12 px every 6th
                db T_BALL,148   : dw 0,32       : db 2,0        ; 2 px every 2nd
                db T_BALL,172   : dw 0,96       : db 2,0        ; 6 px every 2nd
                db 0
scene_labels    db 1,"2/1",0, 4,"4/2",0, 7,"6/3",0, 10,"8/4",0, 13,"10/5",0, 16,"12/6",0, 19,"2/2",0, 22,"6/2",0, #FF
                ENDIF

                IF SCENE == 2
make_tables
                call make_htex
                jp make_vtex
scene_setup
                ld a,2  : ld b,2 : ld c,#46 : call attr_rows
                ld a,6  : ld b,2 : ld c,#45 : call attr_rows
                ld a,10 : ld b,2 : ld c,#44 : call attr_rows
                ld a,14 : ld b,2 : ld c,#43 : call attr_rows
                ld a,18 : ld b,2 : ld c,#47 : call attr_rows
                ld a,22 : ld b,2 : ld c,#42 : call attr_rows
                ld hl,scene_labels
                jp labels
objects
                db T_HBAND,16   : dw 0,8        : db 1,0        ; 0.5 px left
                db T_HBAND,48   : dw 0,16       : db 1,0        ; 1
                db T_HBAND,80   : dw 0,32       : db 1,0        ; 2
                db T_HBAND,112  : dw 0,48       : db 1,0        ; 3
                db T_VBAND,144  : dw 0,16       : db 1,0        ; 1 px up
                db T_VBAND,176  : dw 0,32       : db 1,0        ; 2 px up
                db 0
scene_labels    db 2,"H.5",0, 6,"H1",0, 10,"H2",0, 14,"H3",0, 18,"V1",0, 22,"V2",0, #FF
hmsg            db "SMOOTH MOTION 50 HZ TO 60 HZ * THE QUICK BROWN FOX JUMPS 0123456"
                ENDIF

                IF SCENE == 4
make_tables     jp make_dtex
scene_setup
                ld a,3  : ld b,3 : ld c,#47 : call attr_rows
                ld a,14 : ld b,3 : ld c,#46 : call attr_rows
                ld hl,scene_labels
                jp labels
objects
                db T_DBAND,24   : dw 0,128      : db 1,0        ; 8 px left
                db T_DBAND,112  : dw 0,64       : db 1,0        ; 4 px left
                db 0
scene_labels    db 4,"D8",0, 15,"D4",0, #FF
dmsg            db "ALESTE!*"
dotpat          db %00111100,%01111110,%00111100,0
                ENDIF

                IF SCENE == 5
make_tables
                call make_htex
                call make_vtex
                jp make_tbuf
scene_setup
                ld a,1  : ld b,3 : ld c,#46 : call attr_rows
                ld a,6  : ld b,2 : ld c,#45 : call attr_rows
                ld a,11 : ld b,2 : ld c,#44 : call attr_rows
                ld hl,scene_labels
                jp labels
objects
                db T_BOX,8      : dw 0,16       : db 1,0        ; 1 px per frame around, text bouncing
                db T_HL,48      : dw 0,32       : db 1,0        ; 2 px left
                db T_HR,48      : dw 0,-48      : db 1,0        ; 3 px right
                db T_VL,88      : dw 0,16       : db 1,0        ; 1 px up
                db T_HR,88      : dw 0,32       : db 1,0        ; 2 px left
                db 0
scene_labels    db 1,"BOX",0, 6,"LR",0, 11,"VH",0, #FF
hmsg            db "SMOOTH MOTION 50 HZ TO 60 HZ * THE QUICK BROWN FOX JUMPS 0123456"
btext           db "PRESS KEY FROM 'A' TO 'S' "
bounce          db 0,1,2,3,3,2,1,0
dashr           db #F0,#78,#3C,#1E,#0F,#87,#C3,#E1      ; 4 on, 4 off, moved right by the index
tbuf            ds 8*26
                ENDIF

ball            db %00000111,%11100000
                db %00011111,%11111000
                db %00111111,%11111100
                db %01111111,%11111110
                db %01111111,%11111110
                db %11111111,%11111111
                db %11111111,%11111111
                db %11111111,%11111111
                db %11111111,%11111111
                db %11111111,%11111111
                db %11111111,%11111111
                db %01111111,%11111110
                db %01111111,%11111110
                db %00111111,%11111100
                db %00011111,%11111000
                db %00000111,%11100000

; ---------------------------------------------------------------------------------------------
; Variables
delta           db 0
lastint         db 0
shownext        db 0
pdelta          db 0
tmp             ds 5
srcp            dw 0
b_shift         db 0
b_off           db 0
b_y             db 0
b_line          db 0
vch             db 0
vstart          db 0
vrow            db 0
dline           db 0
ddot            db 0
dfrow           db 0
b_col           db 0
CODE_END

lines           equ (CODE_END + 255) & #FF00
ballsh          equ lines + 384                 ; 8 shifts x 16 lines x 5
htex            equ ballsh + 640                ; 8 shifts x 8 rows x 96
vtex            equ htex + 8*8*96               ; 64 lines x 32
dtex            equ htex                    ; 2 shifts x 24 rows x 96 (scene 4 only)

                IF SCENE == 4
                ASSERT dtex + 2*24*96 <= #C000
                ELSE
                ASSERT vtex + 64*32 <= #C000
                ENDIF

; ---------------------------------------------------------------------------------------------
; Files: the snapshot, a tape and a TR-DOS disk with BASIC loaders (names from the scene file: NAME, FILE_SNA,
; FILE_TAP, FILE_TRD, TRD_CODE)

ZXB_CLEAR       equ #FD
ZXB_VAL         equ #B0
ZXB_REM         equ #EA
ZXB_LOAD        equ #EF
ZXB_CODE        equ #AF
ZXB_RANDOMIZE   equ #F9
ZXB_USR         equ #C0

                savesna FILE_SNA,start

                org #5C00
BASIC_START     db 0,0
                dw LINE_LEN
BASIC_LINE      db ZXB_CLEAR,ZXB_VAL,'"32767":'
                db ZXB_LOAD,'""',ZXB_CODE,':'
                db ZXB_RANDOMIZE,ZXB_USR,ZXB_VAL,'"32768"'
                db 13
BASIC_END
LINE_LEN        equ BASIC_END-BASIC_LINE

                emptytap FILE_TAP
                savetap FILE_TAP,BASIC,"smooth",BASIC_START,BASIC_END-BASIC_START,0
                savetap FILE_TAP,CODE,NAME,start,CODE_END-start

                org #5C00
TRD_START       db 0,0
                dw TRD_LINE0_LEN
TRD_LINE0       db ZXB_CLEAR,ZXB_VAL,'"32767":'
                db ZXB_RANDOMIZE,ZXB_USR,ZXB_VAL,'"15619":',ZXB_REM,":"
                db ZXB_LOAD,'"',NAME,'"',ZXB_CODE
                db 13
TRD_LINE0_END   db 0,1
                dw TRD_LINE1_LEN
TRD_LINE1       db ZXB_RANDOMIZE,ZXB_USR,ZXB_VAL,'"32768"'
                db 13
TRD_LINE1_END
TRD_LINE0_LEN   equ TRD_LINE0_END-TRD_LINE0
TRD_LINE1_LEN   equ TRD_LINE1_END-TRD_LINE1

                emptytrd FILE_TRD
                savetrd FILE_TRD,"boot.B",TRD_START,TRD_LINE1_END-TRD_START,0
                savetrd FILE_TRD,TRD_CODE,start,CODE_END-start
